# ==============================================================================
# OpenLocalRagAgents — Environment Configuration Template
# Copy this file to .env and customize for your deployment.
# ==============================================================================

# ──────────────────────────── LLM & SERVING BACKEND ────────────────────────────
# Backend: "huggingface" (in-process GPU/CPU) or "ollama" (external server)
LLM_BACKEND=huggingface

# HuggingFace Model Configuration
LLM_MODEL_ID=Qwen/Qwen2.5-1.5B-Instruct
LLM_MODEL_DIR=qwen2.5-1.5b

# Ollama Configuration (used when LLM_BACKEND=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_NUM_PARALLEL=4

# Embedding & Reranker Device: "cpu" or "cuda"
# Default: cpu (keeps full GPU VRAM available for LLM)
RAG_DEVICE=cpu

# Chunking Configuration
CHUNK_SIZE=600
CHUNK_OVERLAP=100

# Retrieval: chunks passed to the LLM after reranking, and minimum cosine similarity for candidates
RERANKER_TOP_N=3
RAG_MIN_SIMILARITY=0.325
# Minimum cross-encoder relevance score (0-1) for a chunk to be used as context; below it, questions
# count as "not found in the documents". Tune with `python -m evals.run_eval` (0 disables the check).
RAG_MIN_RERANKER_SCORE=0.005

# Conversation turns kept per session
CHAT_HISTORY_MAX_TURNS=20

# Allow online HuggingFace downloads even if local models exist (0=offline, 1=online)
ALLOW_ONLINE_HF=0

# ──────────────────────────── AUTHENTICATION & SECURITY ────────────────────────
# IMPORTANT: Change these in production!
JWT_SECRET_KEY=
ADMIN_DEFAULT_USERNAME=admin
# With the built-in default 'admin123' the admin must set a new password at first login.
ADMIN_DEFAULT_PASSWORD=admin123
REQUIRE_DEFAULT_PASSWORD_CHANGE=true

# Temporary account lockout after repeated failed logins (per username)
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_WINDOW_SECONDS=900

# Token Expiration (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Password Policy
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_SPECIAL=false

# ──────────────────────────── API CONFIGURATION ────────────────────────────────
# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# Upload Limits
MAX_UPLOAD_SIZE_MB=50

# Rate Limiting (requests per minute; per account when authenticated, per IP otherwise)
RATE_LIMIT_PER_MINUTE=30

# ──────────────────────────── DATABASE (OPTIONAL) ──────────────────────────────
# Leave empty to disable database features and use file-only RAG.
# Examples:
#   PostgreSQL: postgresql+psycopg2://user:pass@localhost:5432/enterprise_db
#   MSSQL: mssql+pyodbc://user:pass@host:1433/db?driver=ODBC+Driver+17+for+SQL+Server
#   MySQL: mysql+pymysql://user:pass@localhost:3306/db
#   SQLite: sqlite:///./data/sample_enterprise.db
DATABASE_URL=

# Comma-separated whitelist of allowed tables (empty = all tables accessible)
DB_ALLOWED_TABLES=
DB_MAX_ROWS=50
# Statement timeout for read-only queries (PostgreSQL / MySQL)
DB_QUERY_TIMEOUT_SECONDS=15
# Recommended: connect with a database account that only has SELECT privileges.

# ──────────────────────────── LOGGING ──────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=app.log

# ──────────────────────────── USER DATA PATHS ──────────────────────────────────
# DATA_DIR=data
# USERS_FILE_PATH=data/users.json
