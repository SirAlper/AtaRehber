# ==============================================================================
# OpenLocalRagAgents — Environment Configuration Template
# Copy this file to .env and customize for your deployment.
# ==============================================================================

# ──────────────────────────── LLM (OLLAMA) ────────────────────────────
# LLM (served by Ollama: https://ollama.com). Pull the model first: ollama pull qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# Context window in tokens; set explicitly because some Ollama versions default to 2048
OLLAMA_NUM_CTX=4096
# Model layers on the GPU (empty = Ollama decides). On 6 GB cards Ollama leaves part of a 7B model on the CPU;
# 99 puts all layers on the GPU if they fit (check with `ollama ps`: "100% GPU").
OLLAMA_NUM_GPU=
# Maximum LLM requests the API sends to Ollama at once
OLLAMA_NUM_PARALLEL=4
# Questions that may wait for the model; beyond that the API answers "busy" (HTTP 503) at once (0 = no limit)
MAX_QUEUED_QUERIES=10
# Questions first check that Ollama is up (result reused for LLM_STATUS_CACHE_SECONDS); while it is down they get
# "language model not available" (HTTP 503) instead of an unverified fallback answer
LLM_STATUS_CHECK=true
LLM_STATUS_CACHE_SECONDS=10
# Optional separate models per task (empty = OLLAMA_MODEL); every model set here must be pulled.
# A stronger grader catches more wrong answers; a small router model keeps routing fast.
OLLAMA_ROUTER_MODEL=
OLLAMA_GRADER_MODEL=
# Answer check: "quotes" (the grader backs every fact with a sentence copied from the documents, verified in code)
# or "simple" (yes/no only; faster, less reliable)
GRADER_MODE=quotes
# Answer check: second look when the grader rejects an answer; numbers of the answer must be in the quoted
# sentences; an answer relying only on a transitional article is sent back once
GRADER_SECOND_OPINION=true
GRADER_NUMBER_CHECK=true
GRADER_TRANSITIONAL_CHECK=true
# Reuse verified answers to first questions (same question, access, and documents); 0 = off
ANSWER_CACHE_SIZE=256
ANSWER_CACHE_MINUTES=1440
# Experimental, off by default (see docs/evaluation.md): copy the evidence before answering; calculator and dates
ANSWER_EVIDENCE_FIRST=false
DOC_AGENT_TOOLS=false

# ──────────────────────────── ORGANIZATION & AGENTS ────────────────────────────
# Name used in prompts, e.g. "Example University" (empty = "the organization")
ORGANIZATION_NAME=
# Agent steps the supervisor may plan for one composite question, and handoffs per question
MAX_AGENT_STEPS=3
MAX_AGENT_HANDOFFS=1
# Ask one question back when the answer depends on something the user did not say ("Kaç gün izin hakkım var?")
CLARIFY_QUESTIONS=true
# Seconds an agent step may take before it is given up and the other steps are answered (0 = no limit)
AGENT_STEP_TIMEOUT_SECONDS=180

# ──────────────────────────── SERVICE REQUESTS & E-MAIL ────────────────────────────
# Categories the request agent files requests under
REQUEST_CATEGORIES=it_support,facilities,academic,administrative,other
# Who is e-mailed about new requests: category=address pairs; "default" covers the other categories
# REQUEST_NOTIFY_EMAILS=it_support=helpdesk@example.edu,default=registrar@example.edu
REQUEST_NOTIFY_EMAILS=
# false: e-mails only say that request #N was filed (no requester, title, or description)
REQUEST_NOTIFY_INCLUDE_DETAILS=true
# Delete resolved / rejected / cancelled requests older than N days (0 = keep). Applied hourly.
REQUEST_RETENTION_DAYS=0
# The organization's own mail server; empty SMTP_HOST disables e-mail
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_TIMEOUT_SECONDS=10

# ──────────────────────────── DATA PROTECTION & BACKUPS ────────────────────────────
# See docs/data_protection.md. Store question text, answer previews, and feedback comments in the audit log
AUDIT_STORE_QUESTIONS=true
# Delete audit entries / conversation sessions older than N days (0 = keep). Applied hourly.
AUDIT_RETENTION_DAYS=0
SESSION_RETENTION_DAYS=0
# Automatic full backups every N hours (0 = off); keep the newest BACKUP_KEEP full backups
BACKUP_INTERVAL_HOURS=0
BACKUP_KEEP=7

# ──────────────────────────── WEB UI ────────────────────────────
# Default language of the web UI ("tr" or "en"; each user can switch) and a disclaimer under the chat for both
# languages. The name, welcome text, example questions and the rest are set by admins: Admin > Appearance.
UI_LANGUAGE=tr
# UI_DISCLAIMER=Answers are AI-generated. For official information contact the relevant department.

# Embedding & Reranker Device: "cpu" or "cuda"
# Default: cpu (keeps full GPU VRAM available for LLM)
RAG_DEVICE=cpu

# Chunking Configuration
CHUNK_SIZE=600
CHUNK_OVERLAP=100
# Laws and regulations are split by article ("Madde 30 –"); longer articles are split into pieces of this size
ARTICLE_CHUNK_SIZE=900

# Retrieval: candidates the vector search hands to the reranker, chunks passed to the LLM after reranking,
# and minimum cosine similarity for candidates
RAG_CANDIDATE_POOL=10
RERANKER_TOP_N=4
RAG_MIN_SIMILARITY=0.325
# Minimum cross-encoder relevance score (0-1) for a chunk to be used as context; below it, questions
# count as "not found in the documents". Tune with `python -m evals.run_eval` (0 disables the check).
# Laws and regulations (article-aware chunks): 0.05 rejects most off-topic questions (docs/evaluation.md).
RAG_MIN_RERANKER_SCORE=0.005

# Conversation turns kept per session
CHAT_HISTORY_MAX_TURNS=20

# Allow online HuggingFace downloads even if local models exist (0=offline, 1=online)
ALLOW_ONLINE_HF=0

# ──────────────────────────── AUTHENTICATION & SECURITY ────────────────────────
# IMPORTANT: Change these in production!
JWT_SECRET_KEY=
ADMIN_DEFAULT_USERNAME=admin
# With the built-in default 'admin123' the admin must set a new password at first login.
ADMIN_DEFAULT_PASSWORD=admin123
REQUIRE_DEFAULT_PASSWORD_CHANGE=true

# Temporary account lockout after repeated failed logins (per username)
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_WINDOW_SECONDS=900

# Token Expiration (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
# Web UI: send its refresh token cookie over HTTPS only (true behind HTTPS; the HTTPS compose sets it):
REFRESH_COOKIE_SECURE=false

# Password Policy
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_SPECIAL=false

# ──────────────────────────── API CONFIGURATION ────────────────────────────────
# Origins of other web pages that call the API from the browser (comma-separated). The web UI needs none: it
# calls /api on its own origin (its nginx, the HTTPS proxy, and the Vite dev server forward it).
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Upload Limits
MAX_UPLOAD_SIZE_MB=50

# Rate Limiting (requests per minute; per account when authenticated, per IP otherwise).
# Questions, uploads, and other changes; reads (GET) have their own budget, as the web UI reloads its panels
# with several GET requests on every click.
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_READS_PER_MINUTE=300

# Guest access: visitors without an account ask about the documents shared with GUEST_DOCUMENT_GROUP only
# (give a document that group to publish it for visitors; every account sees it too)
GUEST_ACCESS_ENABLED=false
GUEST_DOCUMENT_GROUP=ziyaretci
GUEST_SESSION_MINUTES=120
# Questions per minute of one guest session
GUEST_RATE_LIMIT_PER_MINUTE=10

# ──────────────────────────── DATABASE (OPTIONAL) ──────────────────────────────
# Leave empty to disable database features and use file-only RAG.
# Examples:
#   PostgreSQL: postgresql+psycopg2://user:pass@localhost:5432/enterprise_db
#   MSSQL: mssql+pyodbc://user:pass@host:1433/db?driver=ODBC+Driver+17+for+SQL+Server
#   MySQL: mysql+pymysql://user:pass@localhost:3306/db
#   SQLite: sqlite:///./data/sample_enterprise.db
DATABASE_URL=
# With DATABASE_URL empty, a demo database (fictitious products, sales, tickets) is created and used.
# Set to false in real deployments without a database, so data questions are not answered from demo data.
SAMPLE_DB_ENABLED=true

# Comma-separated whitelist of allowed tables (empty = all tables accessible)
DB_ALLOWED_TABLES=
DB_MAX_ROWS=50
# Statement timeout for read-only queries (PostgreSQL / MySQL)
DB_QUERY_TIMEOUT_SECONDS=15
# Recommended: connect with a database account that only has SELECT privileges.

# ──────────────────────────── LOGGING ──────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=app.log

# ──────────────────────────── USER DATA PATHS ──────────────────────────────────
# DATA_DIR=data
# USERS_FILE_PATH=data/users.json
